{
  "name": "nozomi",
  "private": true,
  "version": "1.0.0",
  "description": "A Minecraft Launcher",
  "author": "LegenLee",
  "license": "Apache-2.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0"
    }
  },
  "repository": {
    "type": "git",
