{
  "name": "nozomi",
  "private": true,
  "version": "1.0.0",
  "description": "A Minecraft Launcher",
  "author": "LegenLee",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.18.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.23.0"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/legenlee/nozomi"
  },
  "type": "module",
  "scripts": {
    "main": "pnpm --filter @nozomi/main",
    "renderer": "pnpm --filter @nozomi/renderer",
    "build": "pnpm --filter @nozomi/renderer build && pnpm --filter @nozomi/main build",
    "package": "pnpm run build && pnpm --filter @nozomi/main package",
    "lint": "eslint .",
    "format": "prettier -w .",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.66.0"
  }
}
