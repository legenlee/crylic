{
  "compilerOptions": {
    "target": "esnext",
    "module": "commonjs",

    "allowSyntheticDefaultImports": true,
    "composite": true,
    "noEmit": true,
    "moduleResolution": "node",
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "strict": true,
    "sourceMap": true,
    "skipLibCheck": true
  }
}
